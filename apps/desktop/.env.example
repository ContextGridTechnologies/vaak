# Public frontend configuration only. Values prefixed with VITE_ are bundled
# into the WebView and must never contain API keys, tokens, or secrets.
VITE_APP_ENV=development
VITE_CLOUD_BASE_URL=
VITE_ENABLE_DEBUG_UI=false

# Tauri/Rust runtime configuration. Provider API keys still belong in the OS
# keyring through the app UI, not in environment files.
VAAK_APP_ENV=development
VAAK_LOG_LEVEL=debug
VAAK_UPDATE_CHANNEL=dev
VAAK_ENABLE_TELEMETRY=false
