{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaak",
  "version": "0.1.0",
  "identifier": "ai.bluevoice.app",
  "build": {
    "beforeDevCommand": "node scripts/ensure-dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vaak",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false
      },
      {
        "label": "voice-capsule",
        "title": "Vaak Voice",
        "url": "/?window=voice-capsule",
        "width": 48,
        "height": 28,
        "minWidth": 48,
        "minHeight": 28,
        "maxWidth": 48,
        "maxHeight": 28,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
