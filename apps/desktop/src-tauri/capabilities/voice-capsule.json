{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "voice-capsule",
  "description": "Least-privilege capability for the floating voice capsule",
  "windows": ["voice-capsule"],
  "permissions": [
    "core:window:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "allow-record-startup-checkpoint",
    "allow-record-renderer-heartbeat",
    "allow-record-renderer-error",
    "allow-get-voice-capsule-ready-challenge",
    "allow-record-voice-capsule-ready",
    "allow-capture-dictation-target",
    "allow-insert-into-active-target",
    "allow-get-hotkey-bindings",
    "allow-save-dictation-record",
    "allow-persist-dictation-audio",
    "allow-get-selected-speech-provider",
    "allow-get-assemblyai-voice-agent-token",
    "allow-execute-voice-agent-tool",
    "allow-resolve-voice-agent-tool-approval",
    "allow-release-voice-agent-tool-snapshot",
    "allow-start-assemblyai-streaming-session",
    "allow-send-assemblyai-streaming-audio",
    "allow-stop-assemblyai-streaming-session",
    "allow-cleanup-assemblyai-streaming-sessions",
    "allow-start-deepgram-streaming-session",
    "allow-send-deepgram-streaming-audio",
    "allow-stop-deepgram-streaming-session",
    "allow-cleanup-deepgram-streaming-sessions",
    "allow-start-elevenlabs-streaming-session",
    "allow-send-elevenlabs-streaming-audio",
    "allow-stop-elevenlabs-streaming-session",
    "allow-cleanup-elevenlabs-streaming-sessions",
    "allow-start-smallest-streaming-session",
    "allow-send-smallest-streaming-audio",
    "allow-stop-smallest-streaming-session",
    "allow-cleanup-smallest-streaming-sessions",
    "allow-get-onboarding-state",
    "allow-get-voice-capsule-placement",
    "allow-save-voice-capsule-placement",
    "allow-set-voice-capsule-size-mode",
    "allow-open-main-window",
    "allow-get-microphone-selection",
    "allow-transcribe-recording"
  ]
}
