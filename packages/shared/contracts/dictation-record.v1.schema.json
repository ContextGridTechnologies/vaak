{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaak.dev/schemas/dictation-record.v1.schema.json",
  "title": "DictationRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "userId",
    "installationId",
    "deviceId",
    "sessionId",
    "mode",
    "trigger",
    "platform",
    "capturedAt",
    "target",
    "transcript",
    "insertion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "recordId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "installationId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "type": "string",
      "enum": ["dictation", "command"]
    },
    "trigger": {
      "type": "string",
      "enum": ["hotkey", "manual", "api"]
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "endedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "recording": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "startupMs",
        "streamAcquisitionMs",
        "reusedWarmStream"
      ],
      "properties": {
        "startupMs": {
          "type": "integer",
          "minimum": 0
        },
        "streamAcquisitionMs": {
          "type": "integer",
          "minimum": 0
        },
        "reusedWarmStream": {
          "type": "boolean"
        },
        "analysisMs": {
          "type": "integer",
          "minimum": 0
        },
        "transcriptionMs": {
          "type": "integer",
          "minimum": 0
        },
        "insertionMs": {
          "type": "integer",
          "minimum": 0
        },
        "postProcessingMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "audio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["relativePath", "mimeType", "byteLength"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "processedAudio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["relativePath", "mimeType", "byteLength"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableId",
        "windowTitle",
        "controlName",
        "controlType",
        "controlTypeId",
        "automationId",
        "frameworkId",
        "className",
        "nativeWindowHandle",
        "inputKind",
        "currentValue"
      ],
      "properties": {
        "stableId": {
          "type": "string",
          "minLength": 1
        },
        "windowTitle": {
          "type": "string"
        },
        "controlName": {
          "type": "string"
        },
        "controlType": {
          "type": "string",
          "minLength": 1
        },
        "controlTypeId": {
          "type": "integer"
        },
        "automationId": {
          "type": "string"
        },
        "frameworkId": {
          "type": "string"
        },
        "className": {
          "type": "string"
        },
        "nativeWindowHandle": {
          "type": "integer"
        },
        "inputKind": {
          "type": "string",
          "enum": ["text", "editor", "terminal", "browser", "unknown"]
        },
        "currentValue": {
          "type": ["string", "null"]
        }
      }
    },
    "provider": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["providerId", "modelId"],
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": ["string", "null"]
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawText", "finalText", "characterCount"],
      "properties": {
        "rawText": {
          "type": "string"
        },
        "finalText": {
          "type": "string"
        },
        "characterCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "insertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "errorCode", "errorMessage"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["inserted", "recovered", "skipped", "failed"]
        },
        "method": {
          "type": ["string", "null"]
        },
        "errorCode": {
          "type": ["string", "null"]
        },
        "errorMessage": {
          "type": ["string", "null"]
        }
      }
    },
    "timeline": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["providerRequests"],
      "properties": {
        "recordingStartedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "recordingStoppedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "processingStartedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "audioAnalysisCompletedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "transcriptionStartedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "providerRequestStartedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "providerResponseReceivedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "transcriptionCompletedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "insertionStartedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "insertionCompletedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "recordPersistedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "providerRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segmentIndex",
              "startedAt",
              "completedAt",
              "providerId",
              "modelId"
            ],
            "properties": {
              "segmentIndex": {
                "type": "integer",
                "minimum": 0
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "completedAt": {
                "type": "string",
                "format": "date-time"
              },
              "providerId": {
                "type": "string",
                "minLength": 1
              },
              "modelId": {
                "type": ["string", "null"]
              },
              "status": {
                "type": ["string", "null"],
                "enum": ["succeeded", "failed", null]
              },
              "errorCode": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    }
  }
}
